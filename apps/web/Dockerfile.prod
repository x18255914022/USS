# Продакшн-образ web (ROADMAP v1.0). См. apps/api/Dockerfile.prod — общая схема.
# NEXT_PUBLIC_API_URL не задаётся при сборке → клиентские запросы идут
# на тот же origin (относительные /api/...), их терминирует reverse proxy (Caddy).
FROM node:24-alpine AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @repo/db prisma:generate \
  && pnpm build
# прод-зависимости не отрезаются: pnpm prune --prod не удаляет dev-зависимости в workspace,
# а pnpm deploy не переносит сгенерированный Prisma Client (default output) — см. docs/DEPLOYMENT.md

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app .
USER node
CMD ["node", "apps/web/node_modules/next/dist/bin/next", "start", "apps/web", "-H", "0.0.0.0", "-p", "3000"]
