# Продакшн-переменные USS (ROADMAP v1.0).
# Скопируйте в .env.prod и заполните (файл .env.prod в .gitignore — секреты в git не попадают):
#   cp .env.prod.example .env.prod
# Запуск:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# DATABASE_URL для контейнеров формируется в docker-compose.prod.yml
# из POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB — отдельно его задавать не нужно.

# --- PostgreSQL (сервис postgres) ---
POSTGRES_USER=uss
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=uss

# --- API: обязательные (apps/api/src/env.ts) ---
JWT_SECRET=change_me_at_least_16_chars
REFRESH_TOKEN_SECRET=change_me_at_least_16_chars
# Публичный URL приложения (через proxy). Для домена — https://example.com
APP_URL=http://localhost

# --- API: опциональные ---
# CORS-origins через запятую (в продакшн-режиме без APP_URL ограничен APP_URL)
#ALLOWED_ORIGINS=http://localhost
# Часовой пояс «тихих часов» уведомлений (worker)
#UNIVERSITY_TZ=Europe/Moscow

# --- Telegram (опционально) ---
# Без TELEGRAM_BOT_TOKEN сервисы bot и worker завершаются с кодом 0
# и не перезапускаются (restart: on-failure) — см. docker-compose.prod.yml.
#TELEGRAM_BOT_TOKEN=change_me_at_least_16_chars
# Service-токен API<->bot (заголовок x-bot-token), должен совпадать у API и бота
#BOT_TOKEN=change_me_at_least_16_chars

# --- Seed (опционально; идемпотентен, запускать на каждом up безопасно) ---
#SEED_ADMIN_EMAIL=admin@example.com
#SEED_ADMIN_PASSWORD=change_me_admin_password
