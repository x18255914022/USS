# .env задаётся через env_file/environment в docker-compose.yml, копировать его в образ нельзя —
# env.ts грузит .env с override:true и перебил бы DATABASE_URL из compose
.env
node_modules
**/node_modules
**/dist
*.db
# Кэш turbo и .git не нужны в build-контексте (ускоряет сборку и не сбрасывает кэш слоёв)
.turbo
**/.turbo
.git
