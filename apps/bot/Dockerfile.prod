# Продакшн-образ Telegram-бота (ROADMAP v1.0). См. apps/api/Dockerfile.prod — общая схема.
# Без TELEGRAM_BOT_TOKEN бот печатает сообщение и завершается с кодом 0
# (apps/bot/src/index.ts) — поэтому в docker-compose.prod.yml у него restart: on-failure:
# чистый выход без токена не перезапускается, падение с ненулевым кодом — перезапускается.
FROM node:24-alpine AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @repo/db prisma:generate \
  && pnpm build
# прод-зависимости не отрезаются: pnpm prune --prod не удаляет dev-зависимости в workspace,
# а pnpm deploy не переносит сгенерированный Prisma Client (default output) — см. docs/DEPLOYMENT.md

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app .
USER node
CMD ["node", "apps/bot/dist/index.js"]
